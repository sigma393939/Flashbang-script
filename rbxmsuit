
--[[
    RBXM SUITE
    Version: 2.0
    Purpose: Download, cache, load, and launch RBXM models.

    The Suite does not enable Legacy cursor effects by default.
    The Branch script is responsible for its own cursor and blur effects.
]]

local Suite = {}
Suite.__index = Suite

local Env = (getgenv and getgenv()) or _G

local ROOT = "_rbxm-suite-v2"
local CACHE = ROOT .. "/cache"
local MODULE_CACHE = {}

local HttpService = game:GetService("HttpService")

--==================================================
-- FILESYSTEM
--==================================================

local function hasFileSystem()
    return type(isfile) == "function"
        and type(readfile) == "function"
        and type(writefile) == "function"
        and type(makefolder) == "function"
end

local function ensureFolder(path)
    if not hasFileSystem() then
        return false
    end

    if isfolder and isfolder(path) then
        return true
    end

    pcall(makefolder, path)
    return isfolder and isfolder(path) or false
end

local function ensureFolders()
    ensureFolder(ROOT)
    ensureFolder(CACHE)
end

local function safeRead(path)
    if not hasFileSystem() or not isfile(path) then
        return nil
    end

    local ok, result = pcall(readfile, path)
    if ok then
        return result
    end

    return nil
end

local function safeWrite(path, content)
    if not hasFileSystem() then
        return false
    end

    local ok = pcall(writefile, path, content)
    return ok
end

local function safeDelete(path)
    if not hasFileSystem() or type(delfile) ~= "function" then
        return false
    end

    local ok = pcall(delfile, path)
    return ok
end

local function normalizeName(name)
    name = tostring(name or "asset")
    name = name:gsub("[^%w%-%_%.]", "_")
    return name
end

local function cachePath(name)
    return CACHE .. "/" .. normalizeName(name)
end

ensureFolders()

--==================================================
-- HTTP
--==================================================

local function httpGet(url)
    assert(type(url) == "string" and url ~= "", "A URL is required")

    local requestFunction =
        (syn and syn.request)
        or http_request
        or request

    if type(requestFunction) == "function" then
        local ok, response = pcall(requestFunction, {
            Url = url,
            Method = "GET",
        })

        if ok and response then
            local status = response.StatusCode or response.Status or 200
            local body = response.Body or response.body

            if status >= 200 and status < 300 and body then
                return body
            end
        end
    end

    assert(type(game.HttpGet) == "function",
        "No supported HTTP method is available")

    return game:HttpGet(url)
end

local function isHttpUrl(value)
    return type(value) == "string"
        and value:match("^https?://") ~= nil
end

-- Accepts a direct URL or a repository shorthand:
-- "owner/repository@branch/path/to/file"
local function resolveUrl(source)
    if isHttpUrl(source) then
        return source
    end

    assert(type(source) == "string", "Invalid download source")

    local repository, remainder =
        source:match("^([^@]+)@(.+)$")

    assert(repository and remainder,
        "Use a direct URL or owner/repository@branch/path")

    local branch, path = remainder:match("^([^/]+)/(.+)$")

    if not branch then
        branch = remainder
        path = ""
    end

    local url = "https://raw.githubusercontent.com/"
        .. repository .. "/" .. branch

    if path ~= "" then
        url = url .. "/" .. path
    end

    return url
end

--==================================================
-- DOWNLOAD / CACHE
--==================================================

function Suite.download(source, destination, options)
    options = options or {}

    assert(type(source) == "string", "Source must be a string")

    destination = destination or normalizeName(source)

    local path = cachePath(destination)

    if options.useCache ~= false then
        local cached = safeRead(path)
        if cached then
            return path
        end
    end

    local url = resolveUrl(source)
    local content = httpGet(url)

    assert(type(content) == "string" and #content > 0,
        "Download returned empty content: " .. url)

    if hasFileSystem() then
        assert(safeWrite(path, content),
            "Could not write downloaded file: " .. path)

        return path
    end

    return content
end

function Suite.clearCache(name)
    if name then
        return safeDelete(cachePath(name))
    end

    if not hasFileSystem() then
        return false
    end

    if type(listfiles) ~= "function" then
        return false
    end

    local ok, files = pcall(listfiles, CACHE)
    if not ok or type(files) ~= "table" then
        return false
    end

    for _, file in ipairs(files) do
        pcall(function()
            if isfile(file) then
                delfile(file)
            end
        end)
    end

    table.clear(MODULE_CACHE)
    return true
end

--==================================================
-- MODEL LOADING
--==================================================

local function readAsset(path)
    if type(path) == "string" and isHttpUrl(path) then
        return httpGet(path)
    end

    local content = safeRead(path)
    if content then
        return content
    end

    if type(readfile) == "function" then
        local ok, result = pcall(readfile, path)
        if ok and result then
            return result
        end
    end

    error("Could not read model file: " .. tostring(path))
end

local function assetUrl(path)
    local assetFunction =
        getcustomasset or getsynasset

    assert(type(assetFunction) == "function",
        "This executor does not support getcustomasset/getsynasset")

    local ok, result = pcall(assetFunction, path)

    assert(ok and type(result) == "string",
        "Could not create a local asset URL")

    return result
end

local function loadModel(path)
    -- Some environments expose a direct model loader.
    if type(loadrbxasset) == "function" then
        local ok, result = pcall(loadrbxasset, path)
        if ok and typeof(result) == "Instance" then
            return result
        end
    end

    assert(type(game.GetObjects) == "function",
        "This environment does not support game:GetObjects()")

    local ok, result = pcall(function()
        return game:GetObjects(assetUrl(path))
    end)

    assert(ok and type(result) == "table" and result[1],
        "Failed to load the RBXM model. The executor must support "
        .. "loading local model assets.")

    return result[1]
end

--==================================================
-- SCRIPT / MODULE RESOLUTION
--==================================================

local function findModule(root, moduleName)
    if not root then
        return nil
    end

    for _, instance in ipairs(root:GetDescendants()) do
        if instance:IsA("ModuleScript")
            and instance.Name == moduleName then
            return instance
        end
    end

    return nil
end

local function makeRequire(root)
    local customRequire

    customRequire = function(target)
        if type(target) == "string" then
            local module = findModule(root, target)
            assert(module, "Module not found: " .. target)
            target = module
        end

        assert(typeof(target) == "Instance"
            and target:IsA("ModuleScript"),
            "Suite.require expects a ModuleScript or module name")

        if MODULE_CACHE[target] ~= nil then
            return MODULE_CACHE[target]
        end

        local source
        local okSource, sourceResult = pcall(function()
            return target.Source
        end)

        if okSource then
            source = sourceResult
        end

        -- Standard require is preferred when available.
        local ok, result = pcall(require, target)
        if ok then
            MODULE_CACHE[target] = result
            return result
        end

        -- Source fallback for environments that permit loadstring.
        if source and type(loadstring) == "function" then
            local chunk, compileError = loadstring(source,
                "@" .. target:GetFullName())

            assert(chunk, compileError or "Module compilation failed")

            local environment = setmetatable({
                script = target,
                require = customRequire,
            }, {
                __index = Env,
            })

            if type(setfenv) == "function" then
                pcall(setfenv, chunk, environment)
            end

            local moduleResult = chunk()
            MODULE_CACHE[target] = moduleResult
            return moduleResult
        end

        error(result)
    end

    return customRequire
end

local function prepareModel(model)
    local descendants = model:GetDescendants()

    for _, instance in ipairs(descendants) do
        if instance:IsA("BaseScript") then
            -- Scripts are run explicitly by Suite.launch.
            instance.Disabled = true
        end
    end
end

--==================================================
-- LAUNCH
--==================================================

function Suite.launch(source, options)
    options = options or {}

    local path = source

    if options.download then
        path = Suite.download(source, options.destination, {
            useCache = options.useCache,
        })
    elseif isHttpUrl(source) then
        path = Suite.download(source, options.destination, {
            useCache = options.useCache,
        })
    end

    local model = loadModel(path)

    model.Name = options.name or model.Name or "LoadedRBXM"
    prepareModel(model)

    local parent = options.parent or game:GetService("CoreGui")
    model.Parent = parent

    local context = {
        Model = model,
        Root = model,
        Options = options,
        Require = makeRequire(model),
        Connections = {},
    }

    function context:Disconnect()
        for _, connection in ipairs(self.Connections) do
            pcall(function()
                connection:Disconnect()
            end)
        end

        table.clear(self.Connections)
    end

    if options.runscripts then
        for _, instance in ipairs(model:GetDescendants()) do
            if instance:IsA("LocalScript") then
                local ok, sourceCode = pcall(function()
                    return instance.Source
                end)

                if ok and type(sourceCode) == "string"
                    and type(loadstring) == "function" then
                    local chunk, compileError = loadstring(
                        sourceCode,
                        "@" .. instance:GetFullName()
                    )

                    if chunk then
                        local environment = setmetatable({
                            script = instance,
                            require = context.Require,
                            Suite = Suite,
                        }, {
                            __index = Env,
                        })

                        if type(setfenv) == "function" then
                            pcall(setfenv, chunk, environment)
                        end

                        local ran, runError = pcall(chunk)

                        if not ran and options.debug then
                            warn("[RBXM Suite] Script error:",
                                instance:GetFullName(), runError)
                        end
                    elseif options.debug then
                        warn("[RBXM Suite] Compile error:",
                            instance:GetFullName(), compileError)
                    end
                end
            end
        end
    end

    return context
end

function Suite.require(modelOrContext, moduleName)
    local root = modelOrContext

    if type(modelOrContext) == "table" then
        root = modelOrContext.Root or modelOrContext.Model
    end

    assert(typeof(root) == "Instance",
        "Suite.require expects a model or launch context")

    if not moduleName then
        local module = root:FindFirstChildWhichIsA(
            "ModuleScript", true
        )

        assert(module, "No ModuleScript found in model")

        return makeRequire(root)(module)
    end

    return makeRequire(root)(moduleName)
end

function Suite.useGlobal(name)
    if name then
        return Env[name]
    end

    return Env
end

-- Do not create cursor or blur effects here.
-- The Legacy Branch script owns those effects.
function Suite.startLegacyVisualEffects()
    return false
end

Env.Suite = Suite

return Suite
