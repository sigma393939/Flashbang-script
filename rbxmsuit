
--========================================================
-- LEGACY ROBLOX + SMOOTH CURSOR TRAIL
--========================================================

local Settings = {
    Year = 2012,
    OldGraphics = true,
    HideDisplayName = true,
    SafeChat = true,
    OldConsole = true,
    OldBubbleChat = true,

    CursorTrail = true,
    CursorTrailCount = 10,
    CursorFollowSpeed = 38,

    MotionBlur = true,
    MaxMotionBlur = 5,
}

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local StarterGui = game:GetService("StarterGui")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

--========================================================
-- CLEANUP
--========================================================

local previous = PlayerGui:FindFirstChild("LegacyMotionEffects")
if previous then
    previous:Destroy()
end

local previousBlur = Lighting:FindFirstChild("LegacyMotionBlur")
if previousBlur then
    previousBlur:Destroy()
end

--========================================================
-- SMOOTH CURSOR EFFECTS
--========================================================

local function StartCursorEffects()
    local Gui = Instance.new("ScreenGui")
    Gui.Name = "LegacyMotionEffects"
    Gui.IgnoreGuiInset = true
    Gui.ResetOnSpawn = false
    Gui.DisplayOrder = 100000
    Gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
    Gui.Parent = PlayerGui

    pcall(function()
        UIS.MouseIconEnabled = true
    end)

    local Blur

    if Settings.MotionBlur then
        Blur = Instance.new("BlurEffect")
        Blur.Name = "LegacyMotionBlur"
        Blur.Size = 0
        Blur.Parent = Lighting
    end

    local Trail = {}
    local TrailCount = math.clamp(Settings.CursorTrailCount, 1, 20)
    local Mouse = UIS:GetMouseLocation()
    local MousePosition = Vector2.new(Mouse.X, Mouse.Y)
    local LastMousePosition = MousePosition
    local CursorSpeed = 0
    local CurrentBlur = 0
    local GamepadMode = false
    local Alive = true

    for i = 1, TrailCount do
        local Image = Instance.new("ImageLabel")
        Image.Name = "CursorTrail" .. i
        Image.BackgroundTransparency = 1
        Image.BorderSizePixel = 0
        Image.Image = "rbxasset://textures/ArrowCursor.png"
        Image.Size = UDim2.fromOffset(24, 24)
        Image.AnchorPoint = Vector2.zero
        Image.Position = UDim2.fromOffset(
            MousePosition.X,
            MousePosition.Y
        )
        Image.ImageTransparency = 1
        Image.Visible = false
        Image.ZIndex = i
        Image.Parent = Gui

        Trail[i] = {
            Image = Image,
            Position = MousePosition,
            RenderPosition = MousePosition,
        }
    end

    local Dot = Instance.new("Frame")
    Dot.Name = "GamepadPointer"
    Dot.Size = UDim2.fromOffset(8, 8)
    Dot.AnchorPoint = Vector2.new(0.5, 0.5)
    Dot.BackgroundColor3 = Color3.new(1, 1, 1)
    Dot.BorderSizePixel = 0
    Dot.Visible = false
    Dot.ZIndex = TrailCount + 1
    Dot.Parent = Gui

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(1, 0)
    Corner.Parent = Dot

    local Outline = Instance.new("UIStroke")
    Outline.Color = Color3.new(0, 0, 0)
    Outline.Thickness = 1
    Outline.Parent = Dot

    local function Alpha(Speed, DeltaTime)
        return 1 - math.exp(-Speed * math.min(DeltaTime, 0.05))
    end

    local function SetInputMode(InputType)
        if InputType.Name:match("^Gamepad") then
            GamepadMode = true
        elseif InputType == Enum.UserInputType.MouseMovement
            or InputType == Enum.UserInputType.MouseButton1
            or InputType == Enum.UserInputType.MouseButton2
            or InputType == Enum.UserInputType.MouseButton3
            or InputType == Enum.UserInputType.Touch then
            GamepadMode = false
        end

        Dot.Visible = GamepadMode

        for _, Entry in ipairs(Trail) do
            Entry.Image.Visible = not GamepadMode
        end
    end

    local InputConnection =
        UIS.LastInputTypeChanged:Connect(SetInputMode)

    SetInputMode(UIS:GetLastInputType())

    local RenderConnection

    RenderConnection = RunService.RenderStepped:Connect(function(DeltaTime)
        if not Alive or not Gui.Parent then
            return
        end

        DeltaTime = math.min(DeltaTime, 0.05)

        local CurrentMouse = UIS:GetMouseLocation()
        MousePosition = Vector2.new(CurrentMouse.X, CurrentMouse.Y)

        local Distance = (MousePosition - LastMousePosition).Magnitude
        local InstantSpeed = Distance / math.max(DeltaTime, 1 / 240)

        CursorSpeed +=
            (math.min(InstantSpeed, 2600) - CursorSpeed) * Alpha(18, DeltaTime)

        -- Shift the target positions along the trail.
        for i = TrailCount, 2, -1 do
            Trail[i].Position = Trail[i - 1].Position
        end

        Trail[1].Position = MousePosition

        local IsMoving = Distance > 0.15 and not GamepadMode

        for i, Entry in ipairs(Trail) do
            local Fade = (i - 1) / TrailCount
            local Follow = Settings.CursorFollowSpeed
                * (1 - (i - 1) / (TrailCount * 1.5))

            Entry.RenderPosition = Entry.RenderPosition:Lerp(
                Entry.Position,
                Alpha(Follow, DeltaTime)
            )

            Entry.Image.Position = UDim2.fromOffset(
                Entry.RenderPosition.X,
                Entry.RenderPosition.Y
            )

            Entry.Image.ImageTransparency = math.clamp(
                0.25 + Fade * 0.70,
                0,
                1
            )

            Entry.Image.Visible = IsMoving
        end

        if Blur then
            local TargetBlur = 0

            if not GamepadMode then
                TargetBlur = math.clamp(
                    (CursorSpeed - 350) * 0.055,
                    0,
                    Settings.MaxMotionBlur
                )
            end

            CurrentBlur +=
                (TargetBlur - CurrentBlur) * Alpha(14, DeltaTime)

            Blur.Size = CurrentBlur
        end

        Dot.Position = UDim2.fromOffset(
            MousePosition.X,
            MousePosition.Y
        )

        LastMousePosition = MousePosition
    end)

    Gui.Destroying:Connect(function()
        Alive = false
        RenderConnection:Disconnect()
        InputConnection:Disconnect()

        if Blur then
            Blur:Destroy()
        end
    end)
end

if Settings.CursorTrail then
    StartCursorEffects()
end

--========================================================
-- LEGACY SETTINGS
--========================================================

if Settings.HideDisplayName then
    local function UpdateCharacter(Character)
        local Humanoid = Character:WaitForChild("Humanoid", 10)
        if not Humanoid then
            return
        end

        Humanoid.DisplayDistanceType =
            Enum.HumanoidDisplayDistanceType.Subject
    end

    if Player.Character then
        task.spawn(UpdateCharacter, Player.Character)
    end

    Player.CharacterAdded:Connect(UpdateCharacter)
end

if Settings.OldConsole then
    pcall(function()
        StarterGui:SetCore("TopbarEnabled", true)
    end)
end

--========================================================
-- LOAD LEGACY MODULE
--========================================================

local Suite = getgenv().Suite

if not Suite then
    local SuiteSource = game:HttpGet(
        "https://raw.githubusercontent.com/sigma393939/Flashbang-script/main/rbxmsuit"
    )

    Suite = loadstring(SuiteSource)()
    getgenv().Suite = Suite
end

local Path = Suite.download(
    "yeku/legacy@latest",
    "Legacy.rbxm"
)

local Legacy = Suite.launch(Path, {
    runscripts = true,
    debug = true,
})

if Legacy then
    local Success, Module = pcall(function()
        return Suite.require(Legacy)
    end)

    if Success and Module and Module.Start then
        Module:Start(Settings.Year)
    end
end

