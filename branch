EffectsGui.Destroying:Connect(function()
    if RenderConnection then
        RenderConnection:Disconnect()
    end

    UserInputService.MouseIconEnabled = true

    if ScrollBlur then
        ScrollBlur:Destroy()
    end

    for _, Connection in pairs(ScrollConnections) do
        Connection:Disconnect()
    end
end)

