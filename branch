-- CLEAN OLD INSTANCES
--==================================================

local function RemoveNamed(parent, name)
    if not parent then
        return
    end

    for _, child in ipairs(parent:GetChildren()) do
        if child.Name == name then
            Force(function()
                child:Destroy()
            end)
        end
    end
end

