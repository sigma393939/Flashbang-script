local function ApplyDisplayName(character)
    if not Settings.HideDisplayName or not character then
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
        or character:WaitForChild("Humanoid", 5)

    if humanoid then
        Set(humanoid, "DisplayName", Player.Name)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    if player.Character then
        ApplyDisplayName(player.Character)
    end

    player.CharacterAdded:Connect(function(character)
        task.defer(ApplyDisplayName, character)
    end)
end

