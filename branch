Run(Settings.OldBubbleChat == true, function()
    if not ChatBubbles then
        return
    end

    local BubbleChatConfiguration =
        TextChatService:WaitForChild("BubbleChatConfiguration")

    local SourceSans = Font.fromEnum(Enum.Font.SourceSans)
    local BubbleSize = UDim2.fromOffset(46, 35)

    local PaddingData = {
        PaddingBottom = UDim.new(0, 4),
        PaddingTop = UDim.new(0, 4),
        PaddingLeft = UDim.new(0, 6),
        PaddingRight = UDim.new(0, 6),
    }

    local function ConvertTail(Tail)
        if Tail then
            Set(Tail, {
                Size = UDim2.fromOffset(25, 10),
                ImageTransparency = 0,
                Image = "rbxassetid://89395716827984",
            })
        end
    end

    local function ConvertDistantBubble(Bubble)
        local RoundedFrame = Bubble:FindFirstChild("RoundedFrame")
        local Corner = RoundedFrame
            and RoundedFrame:FindFirstChildOfClass("UICorner")

        local Contents = RoundedFrame
            and RoundedFrame:FindFirstChild("Contents")

        local Padding = Contents
            and Contents:FindFirstChildOfClass("UIPadding")

        local Ellipsis = Contents
            and Contents:FindFirstChildOfClass("TextLabel")

        ConvertTail(Bubble:FindFirstChild("Carat"))

        Set(Bubble, { Size = BubbleSize }, true)
        Set(RoundedFrame, { Size = BubbleSize }, true)
        Set(Contents, { Size = BubbleSize }, true)
        Set(Corner, { CornerRadius = UDim.new(0, 5) })
        Set(Padding, PaddingData)

        Set(Ellipsis, {
            FontFace = SourceSans,
            TextSize = 22,
            TextColor3 = Color3.fromRGB(60, 68, 75),
            TextTransparency = 0,
        }, true)
    end

    local function Convert(Object)
        if Object.Name == "Caret" then
            ConvertTail(Object)
        elseif Object.Name == "DistantBubble" then
            ConvertDistantBubble(Object)
        end
    end

    Set(BubbleChatConfiguration, {
        FontFace = SourceSans,
        TextSize = 22,
        TextColor3 = Color3.fromRGB(60, 68, 75),
        BackgroundTransparency = 0,
        LocalPlayerStudsOffset = Vector3.new(0, 0.4, 0),
    }, true)

    Create("UICorner", {
        CornerRadius = UDim.new(0, 5),
    }, false, BubbleChatConfiguration)

    Create("UIPadding", PaddingData, false, BubbleChatConfiguration)

    for _, Object in ipairs(ChatBubbles:GetDescendants()) do
        Convert(Object)
    end

    ChatBubbles.DescendantAdded:Connect(Convert)
end)

