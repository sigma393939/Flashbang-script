--==================================================
-- CURSOR TRACKING
--==================================================

local CursorPosition = UserInputService:GetMouseLocation()
local PreviousCursorPosition = CursorPosition
local CursorSpeed = 0
local MovementVisibility = 0
local GamepadMode = false

local function IsGamepadInput(inputType)
    return inputType == Enum.UserInputType.Gamepad1
        or inputType == Enum.UserInputType.Gamepad2
        or inputType == Enum.UserInputType.Gamepad3
        or inputType == Enum.UserInputType.Gamepad4
end

UserInputService.LastInputTypeChanged:Connect(function(inputType)
    GamepadMode = IsGamepadInput(inputType)
    GamepadDot.Visible = GamepadMode and Effects.GamepadDotEnabled
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        GamepadMode = false
        GamepadDot.Visible = false
    elseif IsGamepadInput(input.UserInputType) then
        GamepadMode = true
        GamepadDot.Visible = Effects.GamepadDotEnabled
    end
end)

--==================================================
-- SMOOTH SCROLL REGISTRATION
--==================================================

local ScrollFrames = {}
local ScrollConnections = {}

local function RegisterScrollFrame(instance)
    if not instance:IsA("ScrollingFrame") then
        return
    end

    if ScrollFrames[instance] then
        return
    end

    -- Avoid taking over frames that are not actually scrollable.
    if instance.CanvasSize == UDim2.new(0, 0, 0, 0) then
        return
    end

    ScrollFrames[instance] = {
        Frame = instance,
        Target = instance.CanvasPosition,
        Current = instance.CanvasPosition,
        Active = false,
    }

    instance:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
        local data = ScrollFrames[instance]
        if not data or data.Active then
            return
        end

        -- Follow normal Roblox/UI scrolling if another system changes it.
        data.Target = instance.CanvasPosition
        data.Current = instance.CanvasPosition
    end)

    instance.Destroying:Connect(function()
        ScrollFrames[instance] = nil
    end)
end

local function RegisterRoot(root)
    for _, instance in ipairs(root:GetDescendants()) do
        RegisterScrollFrame(instance)
    end

    local connection = root.DescendantAdded:Connect(
        RegisterScrollFrame
    )

    table.insert(ScrollConnections, connection)
end

RegisterRoot(PlayerGui)

local function GetScrollFrameAtMouse(position)
    local ok, objects = pcall(function()
        return PlayerGui:GetGuiObjectsAtPosition(
            position.X,
            position.Y
        )
    end)

    if not ok or type(objects) ~= "table" then
        return nil
    end

    for _, object in ipairs(objects) do
        local current = object

        while current and current ~= PlayerGui do
            if current:IsA("ScrollingFrame")
                and ScrollFrames[current] then
                return current
            end

            current = current.Parent
        end
    end

    return nil
end

local function ClampCanvasPosition(frame, position)
    local maxX = math.max(
        0,
        frame.AbsoluteCanvasSize.X - frame.AbsoluteSize.X
    )

    local maxY = math.max(
        0,
        frame.AbsoluteCanvasSize.Y - frame.AbsoluteSize.Y
    )

    return Vector2.new(
        math.clamp(position.X, 0, maxX),
        math.clamp(position.Y, 0, maxY)
    )
end

local ScrollBlurTarget = 0
local LastWheelTime = 0

-- Only intercept wheel input when an identifiable scrolling frame
-- is under the pointer. Do not use "Processed" as the sole filter:
-- Roblox can mark input processed before this script sees it.
local ScrollInputConnection = UserInputService.InputChanged:Connect(
    function(input, processed)
        if not Effects.SmoothScrolling then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.MouseWheel then
            return
        end

        local mousePosition = UserInputService:GetMouseLocation()
        local frame = GetScrollFrameAtMouse(mousePosition)

        if not frame then
            return
        end

        local data = ScrollFrames[frame]
        if not data then
            return
        end

        -- Use the wheel delta, then let RenderStepped animate the frame.
        local delta = input.Position.Z
        local direction = -delta * Effects.ScrollSpeed

        data.Target = ClampCanvasPosition(
            frame,
            data.Target + Vector2.new(0, direction)
        )

        data.Active = true
        LastWheelTime = os.clock()

        if Effects.ScrollBlurEnabled then
            ScrollBlurTarget = Effects.ScrollBlurMax
        end
    end
)

--==================================================
-- RENDER LOOP
--==================================================

local LastCursorSpeed = 0
local RenderConnection

RenderConnection = RunService.RenderStepped:Connect(function(deltaTime)
    local currentPosition = UserInputService:GetMouseLocation()

    CursorPosition = currentPosition

    local difference = CursorPosition - PreviousCursorPosition
    local instantaneousSpeed = difference.Magnitude
        / math.max(deltaTime, 1 / 240)

    instantaneousSpeed = math.clamp(
        instantaneousSpeed,
        0,
        Effects.TrailMaxSpeed
    )

    CursorSpeed += (
        instantaneousSpeed - CursorSpeed
    ) * SmoothAlpha(Effects.TrailSpeedResponse, deltaTime)

    MovementVisibility = math.clamp(
        CursorSpeed / 350,
        0,
        1
    )

    PreviousCursorPosition = CursorPosition
    LastCursorSpeed = CursorSpeed

    -- Place the newest trail entry near the actual cursor.
    if Effects.TrailEnabled and not GamepadMode then
        local head = TrailEntries[1]

        if head then
            head.Position = CursorPosition
        end

        for index = 2, #TrailEntries do
            local entry = TrailEntries[index]
            local previous = TrailEntries[index - 1]

            local alpha = SmoothAlpha(
                Effects.TrailFollowSpeed,
                deltaTime
            )

            entry.Position = entry.Position:Lerp(
                previous.Position,
                alpha
            )
        end

        for index, entry in ipairs(TrailEntries) do
            local age = (index - 1)
                / math.max(1, #TrailEntries - 1)

            local transparency = math.clamp(
                1 - Effects.TrailOpacity
                    * MovementVisibility
                    * ((1 - age) ^ Effects.TrailFadePower),
                0,
                1
            )

            entry.Image.Position = UDim2.fromOffset(
                entry.Position.X,
                entry.Position.Y
            )

            entry.Image.ImageTransparency = transparency
            entry.Image.Visible = true
        end
    else
        for _, entry in ipairs(TrailEntries) do
            entry.Image.ImageTransparency = 1
        end
    end

    -- Gamepad pointer overlay.
    if GamepadMode and Effects.GamepadDotEnabled then
        local camera = workspace.CurrentCamera
        local viewport = camera and camera.ViewportSize

        if viewport then
            local center = viewport / 2

            GamepadDot.Position = UDim2.fromOffset(
                center.X,
                center.Y
            )
        end

        GamepadDot.Visible = true
    else
        GamepadDot.Visible = false
    end

    -- Cursor-speed blur: low blur, fading quickly when motion stops.
    if Effects.MotionBlurEnabled then
        local speedAboveThreshold = math.max(
            0,
            CursorSpeed - Effects.MotionBlurThreshold
        )

        local targetBlur = math.clamp(
            speedAboveThreshold * Effects.MotionBlurStrength,
            0,
            Effects.MotionBlurMax
        )

        CursorBlur.Size += (
            targetBlur - CursorBlur.Size
        ) * SmoothAlpha(Effects.MotionBlurFadeSpeed, deltaTime)
    else
        CursorBlur.Size = 0
    end

    -- Smooth scroll animation.
    for frame, data in pairs(ScrollFrames) do
        if not frame.Parent then
            ScrollFrames[frame] = nil
        else
            local differencePosition = data.Target - frame.CanvasPosition

            if differencePosition.Magnitude < 0.5 then
                if data.Active then
                    frame.CanvasPosition = data.Target
                end

                data.Active = false
            elseif data.Active then
                local alpha = SmoothAlpha(
                    Effects.ScrollSmoothness,
                    deltaTime
                )

                local nextPosition = frame.CanvasPosition:Lerp(
                    data.Target,
                    alpha
                )

                frame.CanvasPosition = ClampCanvasPosition(
                    frame,
                    nextPosition
                )
            end
        end
    end

    -- Brief, subtle blur during wheel scrolling.
    if os.clock() - LastWheelTime > 0.12 then
        ScrollBlurTarget = 0
    end

    if Effects.ScrollBlurEnabled then
        ScrollBlur.Size += (
            ScrollBlurTarget - ScrollBlur.Size
        ) * SmoothAlpha(Effects.ScrollBlurFadeSpeed, deltaTime)
    else
        ScrollBlur.Size = 0
    end
end)

--==================================================
-- CLEANUP
--==================================================

CursorGui.Destroying:Connect(function()
    if RenderConnection then
        RenderConnection:Disconnect()
    end

    if ScrollInputConnection then
        ScrollInputConnection:Disconnect()
    end

    for _, connection in ipairs(ScrollConnections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    pcall(function()
        CursorBlur:Destroy()
    end)

    pcall(function()
        ScrollBlur:Destroy()
    end)
end)

print("[Legacy] 2016 Branch initialized.")
