local ScrollFrames = {}
local ScrollBlurAmount = 0

local ScrollBlur = Create("BlurEffect", {
    Name = "LegacyScrollSceneBlur",
    Size = 0,
    Enabled = Effects.ScrollBlurEnabled,
}, false, Lighting)

local function RegisterScrollFrame(Frame)
    if not Frame:IsA("ScrollingFrame")
        or ScrollFrames[Frame] then

        return
    end

    ScrollFrames[Frame] = {
        Target = Frame.CanvasPosition,
        Current = Frame.CanvasPosition,
    }
end

local function RegisterRoot(Root)
    for _, Object in ipairs(Root:GetDescendants()) do
        RegisterScrollFrame(Object)
    end

    Root.DescendantAdded:Connect(RegisterScrollFrame)
end

RegisterRoot(PlayerGui)

pcall(function()
    RegisterRoot(LegacyGui)
end)

local function GetScrollFrameAtMouse()
    local Mouse = UserInputService:GetMouseLocation()

    local Success, Objects = pcall(function()
        return PlayerGui:GetGuiObjectsAtPosition(
            math.floor(Mouse.X),
            math.floor(Mouse.Y)
        )
    end)

    if not Success then
        return nil
    end

    for Index = #Objects, 1, -1 do
        local Object = Objects[Index]
        local Parent = Object

        while Parent do
            if Parent:IsA("ScrollingFrame")
                and ScrollFrames[Parent]
                and Parent.Visible then

                return Parent
            end

            Parent = Parent.Parent
        end
    end

    return nil
end

UserInputService.InputChanged:Connect(function(Input, Processed)
    if not Effects.SmoothScrolling or Processed then
        return
    end

    if Input.UserInputType ~= Enum.UserInputType.MouseWheel then
        return
    end

    local Frame = GetScrollFrameAtMouse()

    if not Frame then
        return
    end

    local Data = ScrollFrames[Frame]

    if not Data then
        return
    end

    local Canvas = Frame.AbsoluteCanvasSize
    local Window = Frame.AbsoluteWindowSize

    local MaxX = math.max(0, Canvas.X - Window.X)
    local MaxY = math.max(0, Canvas.Y - Window.Y)

    local Delta = Input.Position.Z * Effects.ScrollSpeed

    Data.Target = Vector2.new(
        math.clamp(Data.Target.X - Delta, 0, MaxX),
        math.clamp(Data.Target.Y - Delta, 0, MaxY)
    )

    ScrollBlurAmount = Effects.ScrollBlurMax
end)

--==================================================
-- RENDER LOOP
--==================================================

local FrameCounter = 0
local MousePosition = UserInputService:GetMouseLocation()

for Index = 1, #TrailPositions do
    TrailPositions[Index] = Vector2.new(
        MousePosition.X,
        MousePosition.Y
    )
end

local RenderConnection

RenderConnection = RunService.RenderStepped:Connect(function(DeltaTime)
    FrameCounter += 1

    local Mouse = UserInputService:GetMouseLocation()
    local Position = Vector2.new(Mouse.X, Mouse.Y)

    -- Native mouse stays enabled for PC.
    -- The gamepad dot appears only when the last input was gamepad.
    if UsingGamepad then
        GamepadDot.Position = UDim2.fromOffset(
            Position.X,
            Position.Y
        )
    end

    -- Sample the actual mouse position.
    -- No cursor interpolation: avoids the floaty cursor delay.
    if Effects.TrailEnabled
        and not UsingGamepad
        and FrameCounter % math.max(1, Effects.TrailSampleRate) == 0 then

        table.insert(TrailPositions, 1, Position)
        table.remove(TrailPositions, #TrailPositions + 1)

        for Index, Image in ipairs(TrailImages) do
            local TrailPosition = TrailPositions[Index]

            Image.Position = UDim2.fromOffset(
                TrailPosition.X,
                TrailPosition.Y
            )

            -- Older copies become increasingly transparent.
            local Age = (Index - 1) / math.max(1, #TrailImages - 1)

            Image.ImageTransparency = math.clamp(
                1 - Effects.TrailOpacity * (1 - Age),
                0,
                1
            )

            Image.Visible = true
        end
    else
        for _, Image in ipairs(TrailImages) do
            Image.Visible = not UsingGamepad
                and Effects.TrailEnabled
        end
    end

    if UsingGamepad then
        for _, Image in ipairs(TrailImages) do
            Image.Visible = false
        end
    end

    -- Eased scrolling
    for Frame, Data in pairs(ScrollFrames) do
        if not Frame.Parent then
            ScrollFrames[Frame] = nil
        else
            local Alpha = 1 - math.exp(
                -Effects.ScrollSmoothness * DeltaTime
            )

            Data.Current = Data.Current:Lerp(
                Data.Target,
                Alpha
            )

            if (Data.Current - Data.Target).Magnitude < 0.1 then
                Data.Current = Data.Target
            end

            if (Frame.CanvasPosition - Data.Current).Magnitude > 0.05 then
                Frame.CanvasPosition = Data.Current
            end
        end
    end

    -- Fade scene blur after scrolling.
    ScrollBlurAmount = math.max(
        0,
        ScrollBlurAmount
            - Effects.ScrollBlurFadeSpeed * DeltaTime
    )

    if Effects.ScrollBlurEnabled then
        ScrollBlur.Size = ScrollBlur.Size
            + (ScrollBlurAmount - ScrollBlur.Size)
            * (1 - math.exp(-Effects.ScrollBlurFadeSpeed * DeltaTime))
    else
        ScrollBlur.Size = 0
    end
end)

