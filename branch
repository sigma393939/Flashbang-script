local UsingGamepad = false
local LastMousePosition = InitialPosition
local CursorSpeed = 0
local CurrentBlur = 0

local function IsGamepad(InputType)
    return string.match(InputType.Name, "^Gamepad") ~= nil
end

local function UpdateInputMode(InputType)
    if IsGamepad(InputType) then
        UsingGamepad = true

    elseif InputType == Enum.UserInputType.MouseMovement
        or InputType == Enum.UserInputType.MouseButton1
        or InputType == Enum.UserInputType.MouseButton2
        or InputType == Enum.UserInputType.MouseButton3
        or InputType == Enum.UserInputType.Touch then

        UsingGamepad = false
    end

    GamepadDot.Visible =
        Effects.GamepadDotEnabled and UsingGamepad

    for _, Entry in ipairs(Trail) do
        Entry.Image.Visible =
            Effects.TrailEnabled and not UsingGamepad
    end
end

local InputConnection =
    UserInputService.LastInputTypeChanged:Connect(UpdateInputMode)

UpdateInputMode(UserInputService:GetLastInputType())

local CursorRenderConnection

CursorRenderConnection = RunService.RenderStepped:Connect(function(DeltaTime)
    DeltaTime = math.min(DeltaTime, 0.05)

    local Mouse = UserInputService:GetMouseLocation()
    local Position = Vector2.new(Mouse.X, Mouse.Y)

    local Distance = (Position - LastMousePosition).Magnitude
    local InstantSpeed = Distance / math.max(DeltaTime, 1 / 240)

    CursorSpeed +=
        (math.min(InstantSpeed, Effects.TrailMaxSpeed) - CursorSpeed)
        * SmoothAlpha(Effects.TrailSpeedResponse, DeltaTime)

    if UsingGamepad then
        GamepadDot.Position = UDim2.fromOffset(Position.X, Position.Y)
    end

    if Effects.TrailEnabled and not UsingGamepad then
        -- The newest position is the real cursor location.
        -- Each following image trails progressively behind it.
        for Index = TrailCount, 2, -1 do
            Trail[Index].Position = Trail[Index - 1].Position
        end

        Trail[1].Position = Position

        for Index, Entry in ipairs(Trail) do
            local Lag = (Index - 1) / math.max(1, TrailCount - 1)
            local FollowSpeed = Effects.TrailFollowSpeed * (1 - Lag * 0.45)

            Entry.RenderPosition = Entry.RenderPosition:Lerp(
                Entry.Position,
                SmoothAlpha(FollowSpeed, DeltaTime)
            )

            Entry.Image.Position = UDim2.fromOffset(
                Entry.RenderPosition.X,
                Entry.RenderPosition.Y
            )

            local Age = (Index - 1) / math.max(1, TrailCount - 1)
            local MovementVisibility = math.clamp(
                CursorSpeed / 500,
                0,
                1
            )

            Entry.Image.ImageTransparency = math.clamp(
                1 - Effects.TrailOpacity * MovementVisibility * (1 - Age),
                0,
                1
            )

            Entry.Image.Visible = Distance > 0.1
                and MovementVisibility > 0.01
        end
    else
        for _, Entry in ipairs(Trail) do
            Entry.Image.Visible = false
        end
    end

    -- Speed-based blur. It fades quickly when the cursor stops.
    if CursorBlur then
        local TargetBlur = 0

        if not UsingGamepad then
            TargetBlur = math.clamp(
                (CursorSpeed - Effects.MotionBlurThreshold)
                    * Effects.MotionBlurStrength,
                0,
                Effects.MotionBlurMax
            )
        end

        CurrentBlur +=
            (TargetBlur - CurrentBlur)
            * SmoothAlpha(Effects.MotionBlurFadeSpeed, DeltaTime)

        CursorBlur.Size = CurrentBlur
    end

    LastMousePosition = Position
end)

