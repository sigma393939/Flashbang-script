--==================================================
-- SMOOTH SCROLLING
--==================================================

local ScrollTargets = {}
local ScrollConnections = {}
local ScrollBlurAmount = 0

-- Blur the 3D scene subtly while scrolling.
-- This does not blur the UI itself.
local ScrollBlur = Create("BlurEffect", {
    Name = "LegacyScrollBlur",
    Size = 0,
    Enabled = true,
}, false, Lighting)

local function RegisterScrollingFrame(Frame)
    if not Frame:IsA("ScrollingFrame") then
        return
    end

    if ScrollTargets[Frame] then
        return
    end

    ScrollTargets[Frame] = {
        Position = Frame.CanvasPosition,
        Target = Frame.CanvasPosition,
        LastInput = 0,
    }

    -- Keep this frame registered if the UI is moved around.
    local Connection = Frame.AncestryChanged:Connect(function()
        if not Frame:IsDescendantOf(game) then
            ScrollTargets[Frame] = nil

            if ScrollConnections[Frame] then
                ScrollConnections[Frame]:Disconnect()
                ScrollConnections[Frame] = nil
            end
        end
    end)

    ScrollConnections[Frame] = Connection
end

local function RegisterExistingFrames(Root)
    for _, Object in ipairs(Root:GetDescendants()) do
        if Object:IsA("ScrollingFrame") then
            RegisterScrollingFrame(Object)
        end
    end

    Root.DescendantAdded:Connect(function(Object)
        if Object:IsA("ScrollingFrame") then
            RegisterScrollingFrame(Object)
        end
    end)
end

RegisterExistingFrames(PlayerGui)

pcall(function()
    RegisterExistingFrames(LegacyGui)
end)

-- Find the topmost scrolling frame under the mouse.
local function FindScrollFrame(Position)
    local Objects = PlayerGui:GetGuiObjectsAtPosition(
        math.floor(Position.X),
        math.floor(Position.Y)
    )

    for Index = #Objects, 1, -1 do
        local Object = Objects[Index]
        local Parent = Object

        while Parent and Parent ~= PlayerGui do
            if Parent:IsA("ScrollingFrame")
                and ScrollTargets[Parent]
                and Parent.Visible then

                return Parent
            end

            Parent = Parent.Parent
        end
    end

    return nil
end

UserInputService.InputChanged:Connect(function(Input, Processed)
    if not Effects.SmoothScrolling or Processed then
        return
    end

    if Input.UserInputType ~= Enum.UserInputType.MouseWheel then
        return
    end

    local MousePosition = UserInputService:GetMouseLocation()
    local Frame = FindScrollFrame(MousePosition)

    if not Frame then
        return
    end

    local Data = ScrollTargets[Frame]

    if not Data then
        return
    end

    -- Cancel the native wheel delta and apply our own eased target.
    -- The target is clamped to the actual canvas bounds.
    local Delta = Input.Position.Z * Effects.ScrollSpeed

    local CanvasSize = Frame.AbsoluteCanvasSize
    local ViewSize = Frame.AbsoluteWindowSize

    local MaxX = math.max(0, CanvasSize.X - ViewSize.X)
    local MaxY = math.max(0, CanvasSize.Y - ViewSize.Y)

    Data.Target = Vector2.new(
        math.clamp(Data.Target.X - Delta, 0, MaxX),
        math.clamp(Data.Target.Y - Delta, 0, MaxY)
    )

    Data.LastInput = os.clock()
    ScrollBlurAmount = Effects.ScrollBlurSize
end)

--==================================================
-- SMOOTH ANIMATION LOOP
--==================================================

local CurrentMouse = UserInputService:GetMouseLocation()
local CursorPosition = Vector2.new(CurrentMouse.X, CurrentMouse.Y)

for _, Item in ipairs(TrailItems) do
    Item.Position = CursorPosition
end

local RenderConnection

RenderConnection = RunService.RenderStepped:Connect(function(DeltaTime)
    local Mouse = UserInputService:GetMouseLocation()
    local Target = Vector2.new(Mouse.X, Mouse.Y)

    -- Cursor interpolation
    if Cursor and Cursor.Parent then
        local Alpha = 1 - math.exp(
            -Effects.CursorSmoothness * DeltaTime
        )

        CursorPosition = CursorPosition:Lerp(Target, Alpha)

        Cursor.Position = UDim2.fromOffset(
            CursorPosition.X,
            CursorPosition.Y
        )

        local Previous = CursorPosition

        for _, Item in ipairs(TrailItems) do
            local TrailAlpha = 1 - math.exp(
                -Effects.CursorSmoothness * 0.75 * DeltaTime
            )

            Item.Position = Item.Position:Lerp(
                Previous,
                TrailAlpha
            )

            Item.Object.Position = UDim2.fromOffset(
                Item.Position.X,
                Item.Position.Y
            )

            Previous = Item.Position
        end
    end

    -- Smooth scrolling interpolation
    for Frame, Data in pairs(ScrollTargets) do
        if not Frame.Parent then
            ScrollTargets[Frame] = nil
        else
            local Alpha = 1 - math.exp(
                -Effects.ScrollSmoothness * DeltaTime
            )

            Data.Position = Data.Position:Lerp(Data.Target, Alpha)

            -- Prevent endless subpixel movement.
            if (Data.Position - Data.Target).Magnitude < 0.1 then
                Data.Position = Data.Target
            end

            if (Frame.CanvasPosition - Data.Position).Magnitude > 0.05 then
                Frame.CanvasPosition = Data.Position
            end
        end
    end

    -- Fade scene blur in and out
    local BlurAlpha = 1 - math.exp(
        -Effects.BlurFadeSpeed * DeltaTime
    )

    if os.clock() - (ScrollBlur.LastInput or 0) > 0.12 then
        ScrollBlurAmount = ScrollBlurAmount
            * math.exp(-Effects.BlurFadeSpeed * DeltaTime)
    end

    ScrollBlur.Size = ScrollBlur.Size
        + (ScrollBlurAmount - ScrollBlur.Size) * BlurAlpha
end)

