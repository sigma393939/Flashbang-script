local function RegisterScrollFrame(Object)
    if not Object:IsA("ScrollingFrame") then
        return
    end

    if ScrollFrames[Object] then
        return
    end

    ScrollFrames[Object] = {
        Target = Object.CanvasPosition,
        Current = Object.CanvasPosition,
    }
end

local function RegisterRoot(Root)
    if not Root then
        return
    end

    RegisterScrollFrame(Root)

    for _, Object in ipairs(Root:GetDescendants()) do
        RegisterScrollFrame(Object)
    end

    Root.DescendantAdded:Connect(RegisterScrollFrame)
end

RegisterRoot(PlayerGui)

pcall(function()
    RegisterRoot(LegacyGui)
end)

local function GetScrollFrameAtMouse()
    local Mouse = UserInputService:GetMouseLocation()
    local Found = {}

    local function CheckRoot(Root)
        if not Root then
            return
        end

        local Success, Objects = pcall(function()
            return Root:GetGuiObjectsAtPosition(
                math.floor(Mouse.X),
                math.floor(Mouse.Y)
            )
        end)

        if Success then
            for _, Object in ipairs(Objects) do
                table.insert(Found, Object)
            end
        end
    end

    CheckRoot(PlayerGui)

    local Success, LegacyObjects = pcall(function()
        return LegacyGui:GetGuiObjectsAtPosition(
            math.floor(Mouse.X),
            math.floor(Mouse.Y)
        )
    end)

    if Success and LegacyObjects then
        for _, Object in ipairs(LegacyObjects) do
            table.insert(Found, Object)
        end
    end

    for Index = #Found, 1, -1 do
        local Object = Found[Index]
        local Parent = Object

        while Parent do
            if Parent:IsA("ScrollingFrame")
                and ScrollFrames[Parent]
                and Parent.Visible then

                return Parent
            end

            Parent = Parent.Parent
        end
    end

    return nil
end

UserInputService.InputChanged:Connect(function(Input, Processed)
    if not Effects.SmoothScrolling or Processed then
        return
    end

    if Input.UserInputType ~= Enum.UserInputType.MouseWheel then
        return
    end

    local Frame = GetScrollFrameAtMouse()

    if not Frame then
        return
    end

    local Data = ScrollFrames[Frame]

    if not Data then
        return
    end

    local Canvas = Frame.AbsoluteCanvasSize
    local Window = Frame.AbsoluteWindowSize

    local MaxX = math.max(0, Canvas.X - Window.X)
    local MaxY = math.max(0, Canvas.Y - Window.Y)

    local Delta = Input.Position.Z * Effects.ScrollSpeed

    Data.Target = Vector2.new(
        math.clamp(Data.Target.X - Delta, 0, MaxX),
        math.clamp(Data.Target.Y - Delta, 0, MaxY)
    )

    ScrollBlurAmount = Effects.ScrollBlurMax
end)

--==================================================
-- SMOOTH SCROLL / BLUR RENDER
--==================================================

local ScrollRenderConnection

ScrollRenderConnection = RunService.RenderStepped:Connect(function(DeltaTime)
    DeltaTime = math.min(DeltaTime, 0.05)

    for Frame, Data in pairs(ScrollFrames) do
        if not Frame.Parent then
            ScrollFrames[Frame] = nil
        else
            local Alpha = SmoothAlpha(
                Effects.ScrollSmoothness,
                DeltaTime
            )

            Data.Current = Data.Current:Lerp(Data.Target, Alpha)

            if (Data.Current - Data.Target).Magnitude < 0.1 then
                Data.Current = Data.Target
            end

            if (Frame.CanvasPosition - Data.Current).Magnitude > 0.05 then
                Frame.CanvasPosition = Data.Current
            end
        end
    end

    ScrollBlurAmount = math.max(
        0,
        ScrollBlurAmount - Effects.ScrollBlurFadeSpeed * DeltaTime
    )

    if ScrollBlur then
        local Target = Effects.ScrollBlurEnabled and ScrollBlurAmount or 0

        ScrollBlur.Size += (Target - ScrollBlur.Size)
            * SmoothAlpha(Effects.ScrollBlurFadeSpeed, DeltaTime)
    end
end)

