--==================================================
-- ORIGINAL LEGACY HELPERS
--==================================================

local function Force(Object, Property, Value)
    if not Object then
        return
    end

    pcall(function()
        if Object[Property] ~= Value then
            Object[Property] = Value
        end

        Object:GetPropertyChangedSignal(Property):Connect(function()
            if Object.Parent and Object[Property] ~= Value then
                Object[Property] = Value
            end
        end)
    end)
end

local function Set(Object, Properties, Forced)
    if not Object then
        return
    end

    for Property, Value in pairs(Properties) do
        local Success, Result = pcall(function()
            Object[Property] = Value

            if Forced then
                Force(Object, Property, Value)
            end
        end)

        if not Success then
            warn("[Legacy] " .. tostring(Result))
        end
    end
end

local function Create(ClassName, Properties, Forced, Parent)
    local Object = Instance.new(ClassName)

    Set(Object, Properties, Forced)

    if Parent then
        Object.Parent = Parent
    end

    return Object
end

local function Run(Enabled, Callback)
    if Enabled then
        task.spawn(Callback)
    end
end

