--==================================================
-- HELPERS
--==================================================

local function Force(Object, Property, Value)
    if not Object then
        return
    end

    pcall(function()
        Object[Property] = Value

        Object:GetPropertyChangedSignal(Property):Connect(function()
            if Object.Parent and Object[Property] ~= Value then
                Object[Property] = Value
            end
        end)
    end)
end

local function Set(Object, Properties, Forced)
    if not Object then
        return
    end

    for Property, Value in pairs(Properties) do
        pcall(function()
            Object[Property] = Value

            if Forced then
                Force(Object, Property, Value)
            end
        end)
    end
end

local function Create(ClassName, Properties, Forced, Parent)
    local Object = Instance.new(ClassName)

    Set(Object, Properties, Forced)

    if Parent then
        Object.Parent = Parent
    end

    return Object
end

local function Run(Enabled, Callback)
    if Enabled then
        task.spawn(Callback)
    end
end

local function SmoothAlpha(Speed, DeltaTime)
    return 1 - math.exp(-Speed * math.min(DeltaTime, 0.05))
end

